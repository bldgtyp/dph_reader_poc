# macOS
.DS_Store
._*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp

# Scratch — spike output that is regenerable.
# NOTE: SketchUp backups (*~.skp) are deliberately NOT ignored; two of them are
# cited evidence in 00_Context/DESIGNPH_DATA_MODEL.md §2.
planning/spikes/**/node_modules/
# Phase 3 vendored runtime payload + built .rbz. Both are regenerable:
#   uv run planning/spikes/pyodide/vendor_payload.py
#   uv run planning/spikes/pyodide/build_rbz.py
# NOTE: this used to ignore `planning/spikes/**/pyodide/`, which also swallowed
# the Phase 3 spike's own source tree. Ignore the payload, not the code.
planning/spikes/pyodide/vendor/
# ...and the copy build_rbz.py stages inside the extension tree, which is the same 15 MB again.
planning/spikes/pyodide/ext/dph_plus_spike/vendor/
planning/spikes/pyodide/dist/
planning/spikes/**/.chrome-profile/

# ⚠ CLIENT DATA. HEADLESS-phase scratch: corpus copies, C-SDK captures, diff output.
# Manifest-tracked, never committed — same rule as pocs/01_sketchup-export/_private/.
planning/spikes/headless/_private/

# POC #1. Same rule as the spike: ignore the payload and the build output, never the code.
#   uv run pocs/01_sketchup-export/tools/vendor_payload.py -> pocs/01_sketchup-export/vendor/
#   uv run pocs/01_sketchup-export/tools/build_rbz.py      -> .../ext/dph_plus_poc/vendor/, .../dist/
pocs/01_sketchup-export/vendor/
pocs/01_sketchup-export/ext/dph_plus_poc/vendor/
pocs/01_sketchup-export/dist/
# Written by build_rbz.py; regenerable, and it carries a build timestamp that would churn.
pocs/01_sketchup-export/ext/dph_plus_poc/build_info.json
# ⚠ CLIENT DATA. Real corpus extractions, fixtures, HBJSON outputs and reports captured from
# BLDGTYP project models. Manifest-tracked, never committed -- this repo may yet become public.
pocs/01_sketchup-export/_private/

# Editable-install metadata, regenerated by `make venv`.
pocs/01_sketchup-export/py/*.egg-info/
# ⚠ NO LOCKFILE, deliberately. `uv lock` resolves the *declared* closure — honeybee-schema,
# pydantic, and Rust `pydantic-core`, which has no pure wheel and cannot exist in Pyodide. The venv
# is built `--no-deps` on purpose so that a passing test says something about what SketchUp will
# run; a committed lock claiming the resolved closure would invite `uv sync` and produce a venv
# that is not the payload. See `pocs/01_sketchup-export/py/pyproject.toml`.
pocs/01_sketchup-export/py/uv.lock

# ---- export hygiene (dph_reader_poc): no client data, ever ----
*.xlsm
*.xlsx
*.ppp
*.3dm
*.gh
corpus/adelphi/*.skp
corpus/adelphi/*.hbjson
